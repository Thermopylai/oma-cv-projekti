<header class="mb-5 border-bottom pb-3 text-center">
    <h1 class="display-3">{{nimi}}</h1>
    <p class="h4 text-muted">{{titteli}}</p>

    <!-- Latausnappi -->
    <a href="/lataa-cv" download class="btn btn-outline-primary btn-sm mb-3 shadow-sm">
        <i class="bi bi-file-earmark-pdf-fill me-2"></i> Lataa CV PDF-muodossa
    </a>

    <div class="mt-3">
        <a href="mailto:{{yhteystiedot.sahkoposti}}" target="_blank" class="text-decoration-none me-3">
            <i class="bi bi-envelope-fill me-1"></i> {{yhteystiedot.sahkoposti}}
        </a>
        <a class="me-3 text-decoration-none" style="cursor: pointer;" data-bs-toggle="modal" data-bs-target="#mapModal">
            <i class="bi bi-geo-alt-fill"></i> {{yhteystiedot.paikkakunta}}
        </a>
        <a href="{{yhteystiedot.linkedin}}" target="_blank" class="text-decoration-none me-3">
            <i class="bi bi-linkedin me-1"></i> LinkedIn
        </a>
        <a href="{{yhteystiedot.github}}" target="_blank" class="text-decoration-none">
            <i class="bi bi-github me-1"></i> GitHub
        </a>
    </div>
</header>

<div class="row">
    <!-- Vasen sarake: Koulutus ja Työkokemus -->
    <div class="col-md-8">
        <section class="mb-5">
            <h2 class="h3 border-start border-primary border-4 ps-2 mb-4">Työkokemus</h2>
            {{#each tyokokemus}}
                <div class="card mb-3 shadow border border-info border-2 bg-dark">
                    <div class="card-body">
                        <h5 class="card-title text-primary">{{rooli}} @ {{yritys}}</h5>
                        <h6 class="card-subtitle mb-2 text-muted">{{aika}}</h6>
                        <p class="card-text">{{kuvaus}}</p>
                    </div>
                </div>
            {{/each}}
        </section>

        <section>
            <h2 class="h3 border-start border-primary border-4 ps-2 mb-4">Koulutus</h2>
            <ul class="list-group list-group-flush shadow border-start border-info border-4 bg-dark">
                {{#each koulutus}}
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>{{tutkinto}}</strong><br>
                            <small class="text-muted">{{koulu}}</small>
                        </div>
                        <span class="badge bg-secondary rounded-pill">{{vuosi}}</span>
                    </li>
                {{/each}}
            </ul>
        </section>
    </div>

    <!-- Oikea sarake: Taidot -->
    <div class="col-md-4 mt-5 mt-md-0">
        <section class="p-4 rounded border-start border-info border-4 shadow bg-dark">
            <h2 class="h4 mb-4 border-bottom border-info border-2 pb-2">Osaaminen</h2>
            {{#each taidot}}
                <div class="mb-3">
                    <label class="form-label d-flex justify-content-between align-items-center">
                        <span>
                            <!-- Tässä kutsutaan helperiä ja annetaan sille taidon nimi -->
                            <i class="bi {{getIcon this.nimi}} text-primary me-2"></i>
                            {{this.nimi}}
                        </span>
                        <span class="badge bg-secondary">{{this.taso}}%</span>
                    </label>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: {{this.taso}}%"></div>
                    </div>
                </div>
            {{/each}}
        </section>
    </div>
</div>

<!-- Google Maps Modaali -->
<div class="modal fade" id="mapModal" tabindex="-1" aria-labelledby="mapModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content bg-dark text-light border-primary shadow-lg">
            <div class="modal-header border-primary">
                <h5 class="modal-title" id="mapModalLabel">Sijainti: {{yhteystiedot.paikkakunta}}</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <!-- Dynaaminen Google Maps upotus -->
                <div class="ratio ratio-16x9">
                    <iframe 
                        src="https://www.google.com/maps/embed/v1/place?key={{googleMapsKey}}&q={{yhteystiedot.paikkakunta}}" 
                        style="border:0;"
                        frameborder="0"
                        referrerpolicy="no-referrer-when-downgrade" 
                        allowfullscreen="" 
                        loading="lazy">
                    </iframe>
                </div>
            </div>
            <div class="modal-footer border-primary">
                <button type="button" class="btn btn-outline-info" data-bs-dismiss="modal">Sulje</button>
            </div>
        </div>
    </div>
</div>

