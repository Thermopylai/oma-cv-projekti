<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-4">Ota yhteyttä</h2>

        {{#if viestiLahetetty}}
            <div class="alert alert-success shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> 
                Kiitos viestistäsi! Palaan asiaan pian.
            </div>
        {{/if}}

        <div class="card shadow-lg border border-info border-4 bg-dark">
            <div class="card-body p-4">
                <form action="/yhteys" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Nimesi</label>
                        <input type="text" name="nimi" class="form-control" required placeholder="Matti Meikäläinen">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Sähköpostiosoitteesi</label>
                        <input type="email" name="email" class="form-control" required placeholder="matti@esimerkki.fi">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Viesti</label>
                        <textarea name="viesti" class="form-control" rows="4" required placeholder="Kirjoita viestisi tästä..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-send-fill me-2"></i> Lähetä viesti
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
